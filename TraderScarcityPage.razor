@page "/traderscarcity"
@using System.Reflection
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using SPTarkov.Server.Core.Helpers.Server
@using SPTarkov.Server.Web.Layout
@attribute [Authorize(Policy = "Administrator")]
@layout BaseMudBlazorLayout
@inject ModHelper ModHelper
@inject ItemCatalog Catalog

<PageTitle>Trader Scarcity</PageTitle>

<style>
    .scarcity-page { padding: 72px 24px 24px; display: flex; flex-direction: column; gap: 16px; }
    .scarcity-columns { display: flex; gap: 24px; align-items: flex-start; flex-wrap: wrap; }
    .scarcity-settings { flex: 0 1 600px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
    .scarcity-recipes { flex: 1 1 640px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
    .scarcity-header { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
    .scarcity-row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .scarcity-section { display: flex; flex-direction: column; gap: 4px; }
    .scarcity-table td { vertical-align: top; }
    .scarcity-panels { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; margin-top: 8px; }
    .scarcity-panel { border: 1px solid var(--mud-palette-lines-default); border-radius: 4px; padding: 8px 12px; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    /* Takes the height of the traders panel beside it instead of growing; the item list scrolls. Stacked on a narrow page it gets a fixed height. */
    .scarcity-panel-fill { position: relative; min-height: 280px; min-width: 0; }
    .scarcity-panel-fill > .scarcity-panel { position: absolute; inset: 0; }
    /* MudBlazor's input control grows to fill a flex column - kept to its own height so the space goes to the list */
    .scarcity-panel-fill .scarcity-panel > * { flex: 0 0 auto; }
    .scarcity-panel-fill .scarcity-panel > .scarcity-excluded-list { flex: 1 1 0; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; padding-right: 4px; }
    .scarcity-excluded { display: flex; gap: 8px; align-items: center; }
    .scarcity-excluded-name { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; line-height: 1.2; }
    .scarcity-excluded-id { font-size: 11px; opacity: .6; }
    .scarcity-unknown { color: var(--mud-palette-error); }
</style>

<div class="scarcity-page">
    <div class="scarcity-columns">
    <div class="scarcity-settings">
    <div class="scarcity-header">
        <MudText Typo="Typo.h5">Trader Scarcity</MudText>
        <MudSwitch T="bool" Value="AssortScarcity.Config.EnableScarcity" ValueChanged="v => SaveMaster(config => config.EnableScarcity = v)" Color="Color.Primary"
                   Disabled="@(ScarcityConfig.LoadError != null)" Label="@(AssortScarcity.Config.EnableScarcity ? "Enabled" : "Disabled")" />
    </div>
    <MudText Typo="Typo.body2">Every restock, each trader offer rolls whether it is in stock at all, and if so, how many. Saved changes are written to config.json and apply from each trader's next restock, without restarting the server.</MudText>

    @if (ScarcityConfig.LoadError != null)
    {
        <MudAlert Severity="Severity.Error">@ScarcityConfig.LoadError The mod is running on its defaults. Fix the file and restart the server. Saving is disabled so nothing in it is lost.</MudAlert>
    }
    @if (_status != null)
    {
        <MudAlert Severity="_statusSeverity" ShowCloseIcon="true" CloseIconClicked="() => _status = null">@_status</MudAlert>
    }
    @if (!AssortScarcity.Config.EnableScarcity)
    {
        <MudAlert Severity="Severity.Info">Trader scarcity is off. Each trader goes back to full stock at its next restock. The settings below are kept for when it is turned back on.</MudAlert>
    }

    <div class="scarcity-row">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@(!_dirty || !IsValid || ScarcityConfig.LoadError != null)">Save settings</MudButton>
        <MudButton Variant="Variant.Text" OnClick="Revert" Disabled="@(!_dirty)">Discard changes</MudButton>
        <MudButton Variant="Variant.Text" OnClick="ResetToDefaults">Reset to defaults</MudButton>
        @if (_dirty)
        {
            <MudText Typo="Typo.body2">Unsaved changes</MudText>
        }
    </div>

    <MudPaper Class="pa-4" Outlined="true">
        <div class="scarcity-section">
            <MudText Typo="Typo.h6">Traders</MudText>
            <MudSwitch T="bool" Value="_config.IncludeModdedTraders" ValueChanged="v => Set(() => _config.IncludeModdedTraders = v)" Color="Color.Primary"
                       Label="Include modded traders" />
            <MudText Typo="Typo.caption">Also roll stock for traders added by other mods, each of which can be turned off below. Off, every modded trader goes back to full stock at its next restock.</MudText>
            <div class="scarcity-panels">
                <div class="scarcity-panel">
                    <MudText Typo="Typo.subtitle2">Base game traders</MudText>
                    <MudText Typo="Typo.caption">Unticked traders keep their normal stock.</MudText>
                    @foreach (string trader in ScarcityConfig.TraderNames)
                    {
                        <MudCheckBox T="bool" Value="_config.IsTraderEnabled(trader)" ValueChanged="v => Set(() => _config.Traders[trader] = v)" Color="Color.Primary"
                                     Dense="true" Label="@trader" />
                    }

                    <MudText Typo="Typo.subtitle2" Class="mt-3">Modded traders</MudText>
                    @if (ScarcityConfig.InstalledModdedTraders.Count == 0)
                    {
                        <MudText Typo="Typo.caption">No modded traders are installed.</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption">@(_config.IncludeModdedTraders ? "Found when the server started. A newly installed trader is ticked." : "Include modded traders is off, so none of these are affected.")</MudText>
                        @foreach (var (id, name) in ScarcityConfig.InstalledModdedTraders)
                        {
                            <MudCheckBox T="bool" Value="_config.IsModdedTraderEnabled(id)" ValueChanged="v => Set(() => _config.ModdedTraders[id] = v)" Color="Color.Primary"
                                         Dense="true" Label="@name" Disabled="@(!_config.IncludeModdedTraders)" />
                        }
                    }
                </div>
                <div class="scarcity-panel-fill">
                <div class="scarcity-panel">
                    <MudText Typo="Typo.subtitle2">Never scarce</MudText>
                    <MudText Typo="Typo.caption">Items here are never rolled, at any trader. They keep each trader's normal stock.</MudText>
                    <div class="scarcity-picker"><ItemPicker Placeholder="Add an item..." OnPicked="Exclude" /></div>
                    <div class="scarcity-excluded-list">
                    @if (_config.ExcludedItems.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mt-1" Style="opacity: .7">No items excluded.</MudText>
                    }
                    @foreach (string id in _config.ExcludedItems.ToList())
                    {
                        CatalogItem? item = Catalog.Get(id);
                        <div class="scarcity-excluded">
                            <div class="scarcity-excluded-name">
                                @if (item != null)
                                {
                                    <MudText Typo="Typo.body2">@item.Name</MudText>
                                    <span class="scarcity-excluded-id">@item.Category · @id</span>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Class="scarcity-unknown">Unknown item</MudText>
                                    <span class="scarcity-excluded-id">@id</span>
                                }
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="Remove"
                                           OnClick="() => Set(() => _config.ExcludedItems.Remove(id))" />
                        </div>
                    }
                    </div>
                </div>
                </div>
            </div>
        </div>
    </MudPaper>

    <MudPaper Class="pa-4" Outlined="true">
        <div class="scarcity-section">
            <MudText Typo="Typo.h6">Stock</MudText>
            <MudText Typo="Typo.body2">In-stock chance is how likely an offer is to be in stock after a restock. When it is, the trader has between Min and Max of it.</MudText>
            <MudSimpleTable Dense="true" Elevation="0" Class="scarcity-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>In-stock chance (%)</th>
                        <th>Min</th>
                        <th>Max</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach ((string name, string description, Func<ScarcityConfig, StockRule> get) in Categories)
                    {
                        StockRule rule = get(_config);
                        <tr>
                            <td>
                                <MudText Typo="Typo.body1">@name</MudText>
                                <MudText Typo="Typo.caption">@description</MudText>
                            </td>
                            <td>
                                <MudNumericField T="double" Value="Percent(rule.InStockChance)" ValueChanged="v => Set(() => rule.InStockChance = FromPercent(v))"
                                                 Min="0" Max="100" Step="5" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 130px" />
                            </td>
                            <td>
                                <MudNumericField T="int" Value="rule.Min" ValueChanged="v => Set(() => rule.Min = v)" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 110px"
                                                 Error="@(rule.Min < 1)" ErrorText="At least 1" />
                            </td>
                            <td>
                                <MudNumericField T="int" Value="rule.Max" ValueChanged="v => Set(() => rule.Max = v)" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 110px"
                                                 Error="@(rule.Max < rule.Min)" ErrorText="Can't be below Min" />
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    </MudPaper>

    <MudPaper Class="pa-4" Outlined="true">
        <div class="scarcity-section">
            <MudText Typo="Typo.h6">Loyalty boon</MudText>
            <MudNumericField T="double" Label="Loyalty boon chance (%)" Value="Percent(_config.LoyaltyBumpChance)" ValueChanged="v => Set(() => _config.LoyaltyBumpChance = FromPercent(v))"
                             Min="0" Max="100" Step="1" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 220px" />
            <MudText Typo="Typo.caption">Chance for an in-stock LL2+ offer to be sold one loyalty level lower until the next restock. At 10%, if 20 LL2 offers roll in stock, about 2 become available at LL1. Quest-locked offers are never lowered.</MudText>
        </div>
    </MudPaper>

    <MudPaper Class="pa-4" Outlined="true">
        <div class="scarcity-section">
            <MudText Typo="Typo.h6">Logging</MudText>
            <MudSwitch T="bool" Value="_config.LogRolls" ValueChanged="v => Set(() => _config.LogRolls = v)" Color="Color.Primary"
                       Label="Log rolls" />
            <MudText Typo="Typo.caption">Print a summary to the server console on every stock roll, including each loyalty boon.</MudText>
        </div>
    </MudPaper>
    </div>

    <div class="scarcity-recipes">
        <RecipeEditor>
            <HeaderActions>
                <MudSwitch T="bool" Value="AssortScarcity.Config.EnableRecipes" ValueChanged="v => SaveMaster(config => config.EnableRecipes = v)" Color="Color.Primary"
                           Disabled="@(ScarcityConfig.LoadError != null)" Label="@(AssortScarcity.Config.EnableRecipes ? "Enabled" : "Disabled")" />
            </HeaderActions>
        </RecipeEditor>
    </div>
    </div>
</div>

@code {
    private static readonly (string Name, string Description, Func<ScarcityConfig, StockRule> Get)[] Categories =
    {
        ("Ammo", "Loose rounds", config => config.Ammo),
        ("Ammo boxes", "Boxed ammo", config => config.AmmoBox),
        ("Gear", "Weapons, armor, plates, helmets, rigs, backpacks, weapon mods", config => config.Gear),
        ("Other", "Everything else: meds, provisions, barter items, keys, containers", config => config.Other),
    };

    private ScarcityConfig _config = new();
    private bool _dirty;
    private string? _status;
    private Severity _statusSeverity = Severity.Success;

    private string ModFolder => ModHelper.GetAbsolutePathToModFolder(Assembly.GetExecutingAssembly());

    private bool IsValid => _config.LoyaltyBumpChance is >= 0 and <= 1
        && Categories.Select(category => category.Get(_config))
            .All(rule => rule.InStockChance is >= 0 and <= 1 && rule.Min >= 1 && rule.Max >= rule.Min);

    protected override void OnInitialized()
    {
        _config = AssortScarcity.Config.Clone();
    }

    private void Exclude(string id)
    {
        if (!_config.ExcludedItems.Contains(id, StringComparer.OrdinalIgnoreCase))
        {
            Set(() => _config.ExcludedItems.Add(id));
        }
    }

    private void Set(Action change)
    {
        change();
        _dirty = true;
    }

    private static double Percent(double chance) => Math.Round(chance * 100, 2);

    private static double FromPercent(double percent) => Math.Round(Math.Clamp(percent, 0, 100) / 100, 4);

    private void Save()
    {
        try
        {
            ScarcityConfig.Save(ModFolder, _config, Catalog.NameOf);
            _dirty = false;
            _statusSeverity = Severity.Success;
            _status = "Saved. Trader stock follows these settings from each trader's next restock.";
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException)
        {
            _statusSeverity = Severity.Error;
            _status = $"Could not save: {ex.Message}";
        }
    }

    // The master switches save straight away. Only that one value is written, on top of the live settings,
    // so unsaved edits in the form are neither saved nor lost.
    private void SaveMaster(Action<ScarcityConfig> change)
    {
        ScarcityConfig live = AssortScarcity.Config.Clone();
        change(live);
        try
        {
            ScarcityConfig.Save(ModFolder, live, Catalog.NameOf);
            change(_config);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException)
        {
            _statusSeverity = Severity.Error;
            _status = $"Could not save: {ex.Message}";
        }
    }

    private void Revert()
    {
        _config = AssortScarcity.Config.Clone();
        _dirty = false;
        _status = null;
    }

    // Only fills the form - nothing is written until Save
    private void ResetToDefaults()
    {
        // The master switches are left as they are - they save on their own
        _config = new ScarcityConfig
        {
            EnableScarcity = AssortScarcity.Config.EnableScarcity,
            EnableRecipes = AssortScarcity.Config.EnableRecipes,
        };
        _dirty = true;
        _status = null;
    }
}
