<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TraderScarcity</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>0.3.2</Version>
    <!-- The two lines below will set the output path for the binaries -->
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.2" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.2" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.2" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.1.2" />
    <PackageReference Include="SPTarkov.Server.Web" Version="4.1.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="recipes.jsonc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The client plugin is its own project (Client\TraderScarcity.Client.csproj) - keep its sources out of the server build -->
  <ItemGroup>
    <Compile Remove="Client\**" />
    <None Remove="Client\**" />
    <Content Remove="Client\**" />
  </ItemGroup>

  <!-- Release builds also produce dist\TraderScarcity-<Version>.zip, laid out to be extracted straight into the game folder (SPT_Runtime\user\mods\...) -->
  <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageStaging>$(BaseIntermediateOutputPath)package\</PackageStaging>
      <PackageModFolder>$(PackageStaging)SPT_Runtime\user\mods\$(AssemblyName)\</PackageModFolder>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageStaging)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll;$(OutputPath)config.json;$(OutputPath)recipes.jsonc;$(MSBuildProjectDirectory)\LICENSE" DestinationFolder="$(PackageModFolder)" />
    <!-- Client plugin (merges multi-option recipes into one card) - goes to BepInEx\plugins\TraderScarcity\ -->
    <MSBuild Projects="Client\TraderScarcity.Client.csproj" Properties="Configuration=Release;IsRestoring=true" Targets="Restore" />
    <MSBuild Projects="Client\TraderScarcity.Client.csproj" Properties="Configuration=Release" Targets="Build" />
    <Copy SourceFiles="Client\bin\Release\TraderScarcity.Client.dll" DestinationFolder="$(PackageStaging)BepInEx\plugins\$(AssemblyName)\" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\dist" />
    <ZipDirectory SourceDirectory="$(PackageStaging)" DestinationFile="$(MSBuildProjectDirectory)\dist\$(AssemblyName)-$(Version).zip" Overwrite="true" />
  </Target>

</Project>
